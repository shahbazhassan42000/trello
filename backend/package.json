{
  "name": "user_rest_api_crud",
  "version": "1.0.0",
  "description": "REST API for user.",
  "main": "index.js",
  "scripts": {
    "dev": "NODE_ENV=development nodemon src --exec \"./node_modules/.bin/babel-node src\"",
    "build": "npm install --prefix ../frontend && npm run build --prefix ../frontend && npm install && babel src -s -D -d dist",
    "start": "NODE_ENV=production node ./dist/index.js",
    "lint": "eslint src/**/*.js",
    "precommit-msg": "echo 'Precommit checks...' && exit 0",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*": "prettier --write"
  },
  "format:write": "prettier --write .",
  "lint:check": "eslint .",
  "lint:fix": "eslint --fix .",
  "repository": {
    "type": "git",
    "url": "git@github.com:shahbazhassan42000/trello.git"
  },
  "author": "shahbazhassan42000@gmail.com",
  "homepage": "git@github.com:shahbazhassan42000/trello.git#readme",
  "dependencies": {
    "cors": "^2.8.4",
    "husky": "^8.0.1",
    "dotenv": "^16.4.5",
    "rimraf": "^2.6.2",
    "express": "^4.16.2",
    "mongodb": "^4.8.0",
    "mongoose": "^6.4.4",
    "passport": "^0.6.0",
    "babel-cli": "^6.26.0",
    "express-jwt": "^7.7.2",
    "babel-eslint": "^8.2.2",
    "body-parser": "^1.18.2",
    "morgan-body": "^2.3.1",
    "jsonwebtoken": "^8.5.1",
    "swagger-jsdoc": "^6.2.1",
    "passport-local": "^1.0.0",
    "babel-preset-env": "^1.6.1",
    "swagger-ui-express": "^2.0.15",
    "babel-preset-stage-0": "^6.24.1",
    "mongoose-unique-validator": "^3.1.0",
    "babel-plugin-transform-runtime": "^6.23.0"
  },
  "devDependencies": {
    "eslint": "^8.16.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.8.0",
    "eslint-plugin-jsx-a11y": "^6.0.3",
    "eslint-plugin-react": "^7.5.1",
    "nodemon": "^2.0.16",
    "pre-commit": "^1.2.2",
    "prettier": "2.6.2"
  }
}
